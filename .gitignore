# ── Pi runtime data lives under agent/. Ignore it all, then re-include the
#    handful of files that are actually configuration worth version-controlling.
agent/*
!agent/settings.json
!agent/AGENTS.md
!agent/agents/
!agent/criteria/
!agent/extensions/
!agent/skills/
!agent/prompts/
!agent/themes/

# ── Hard denials. These sit under agent/ and must NEVER be tracked, even if
#    someone loosens the negations above.
agent/auth.json
agent/trust.json
agent/models.json
agent/models-store.json
agent/sessions/
agent/git/
agent/npm/

# ── pi-web-access writes its config to $PI_CODING_AGENT_DIR/web-search.json

# ── Staging area for files removed on a machine where deletes are blocked.
#    Safe to remove by hand once you have checked the contents.
/_to_delete/
/_backup-precfg/, and
#    falls back to ~/.pi/web-search.json

# ── Staging area for files removed on a machine where deletes are blocked.
#    Safe to remove by hand once you have checked the contents.
/_to_delete/
/_backup-precfg/ when that env var is unset — i.e. the
#    root of THIS repo. It holds plaintext provider API keys. Never commit it.
/web-search.json

# ── Staging area for files removed on a machine where deletes are blocked.
#    Safe to remove by hand once you have checked the contents.
/_to_delete/
/_backup-precfg/

# ── Extension build artifacts
agent/extensions/**/node_modules/
agent/extensions/**/*.lock
scripts/verifier/.venv/
scripts/verifier/__pycache__/
scripts/verifier/*.sqlite3*

# ── OS
.DS_Store
