# ── Pi runtime data lives under agent/. Ignore it all, then re-include the
#    handful of files that are actually configuration worth version-controlling.
agent/*
!agent/settings.json
!agent/mcp.json
!agent/jev.json
!agent/models.json
!agent/zentui.json
!agent/AGENTS.md
!agent/extensions/
!agent/skills/
!agent/prompts/
!agent/themes/

# ── Hard denials. These sit under agent/ and must NEVER be tracked, even if
#    someone loosens the negations above.
agent/auth.json
agent/trust.json
# Provider definitions are safe to track; credentials remain in auth.json.
agent/models-store.json
agent/sessions/
agent/git/
agent/npm/

# ── pi-web-access may place plaintext provider keys in the repo root.
/web-search.json

# ── Staging area for files removed on a machine where deletes are blocked.
#    Safe to remove by hand once you have checked the contents.
/_to_delete/
/_backup-precfg/

# ── Extension build artifacts
agent/extensions/**/node_modules/
agent/extensions/**/*.lock

# ── OS
.DS_Store
