{
  "manifest_version": 3,
  "name": "Pikachu Browser Use",
  "version": "2.0.1",
  "description": "Provides focus-protected browser lifecycle and exact-tab control for Pi.",
  "key": "",
  "permissions": ["tabs", "windows", "tabGroups", "bookmarks", "nativeMessaging", "storage", "debugger"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
